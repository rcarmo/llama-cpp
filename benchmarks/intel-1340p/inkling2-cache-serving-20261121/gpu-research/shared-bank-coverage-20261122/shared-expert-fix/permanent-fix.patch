diff --git a/src/llama-moe-copy.h b/src/llama-moe-copy.h
new file mode 100644
index 000000000..77fd800fc
--- /dev/null
+++ b/src/llama-moe-copy.h
@@ -0,0 +1,20 @@
+#pragma once
+
+#include "llama-model.h"
+
+inline bool llama_moe_weight_is_shared(const llama_model & model, const ggml_tensor * weight) {
+    if (weight == nullptr) {
+        return false;
+    }
+    bool seen = false;
+    for (const auto & layer : model.layers) {
+        if (weight == layer.ffn_gate_exps || weight == layer.ffn_up_exps ||
+            weight == layer.ffn_down_exps || weight == layer.ffn_gate_up_exps) {
+            if (seen) {
+                return true;
+            }
+            seen = true;
+        }
+    }
+    return false;
+}
