      "parsed": {
        "content": "```javascript\nfunction mergeIntervals(xs) {\n  // Handle empty input\n  if (xs.length === 0) return [];\n\n  // Create a shallow copy of the outer array and copy each inner pair\n  // so that the original `xs` and its pairs are never mutated.\n  const intervals = xs.map(([start, end]) => [start, end]);\n\n  // Sort intervals by their start value (and by end as a tie‑breaker).\n  intervals.sort((a, b) => a[0] - b[0] || a[1] - b[1]);\n\n  const merged = [];\n  let current = intervals[0];\n\n  for (let i = 1; i < intervals.length; i++) {\n    const next = intervals[i];\n    // Intervals touch or overlap when the next start is <= current end.\n    // Because endpoints are inclusive, [1,2] and [2,3] merge into [1,3].\n    if (next[0] <= current[1]) {\n      // Extend the current interval if needed.\n      if (next[1] > current[1]) {\n        current[1] = next[1];\n      }\n    } else {\n      // No overlap/touch – push the current interval and start a new one.\n      merged.push(current);\n      current = next;\n    }\n  }\n\n  // Push the last accumulated interval.\n  merged.push(current);\n  return merged;\n}\n```",
