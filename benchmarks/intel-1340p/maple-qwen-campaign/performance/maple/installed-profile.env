# Intel Core i5-1340P Maple Preview local-provider profile
# Install as ~/.config/llama-maple-local-provider/service.env.

LLAMA_ROOT=/var/home/agent/workspace/projects/llama-cpp
LLAMA_BUILD=/var/home/agent/workspace/projects/llama-cpp/build-intel-clang
LLAMA_MODEL=/var/home/agent/workspace/projects/models/maple-preview-tq2-exact-head.gguf
LLAMA_ALIAS=maple-preview-tq2-exact-head

LLAMA_HOST=127.0.0.1
LLAMA_PORT=8093

# Two independent 131072-token slots use a 262144-token aggregate context.
LLAMA_CTX=262144
LLAMA_PARALLEL=2

LLAMA_KV=f16
LLAMA_BATCH=2048
LLAMA_UBATCH=512
LLAMA_THREADS=8
LLAMA_CPUS=0-7
LLAMA_PROCESS_CPUS=0-15

# Maple supports whole-prefix prompt-state restore and context checkpoints.
# Per-layer RoPE prevents safe KV shifting, so partial chunk reuse and context
# shifting remain disabled in the launcher.
LLAMA_CACHE_RAM_MIB=12288
LLAMA_CTX_CHECKPOINTS=32
LLAMA_CHECKPOINT_MIN_STEP=8192
LLAMA_SLOT_DIR=/var/home/agent/.cache/llama-maple-local-provider/slots/
LLAMA_HTTP_TIMEOUT=7200

GGML_CPU_EXPERT_IO_PROFILE=1
GGML_CPU_EXPERT_IO_ADVISE_MODE=off
