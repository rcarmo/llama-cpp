+        int64_t job = params->ith;
+        while (job < nb_job) {
+            const int64_t begin = job * 12;
+            const int64_t end = begin + 12 < m ? begin + 12 : m;
+            int64_t ii = begin;
+            for (; ii + 3 <= end; ii += 3) gemm_bloc_value3<3, 4>(ii, 0);
+            if (end - ii == 2) gemm_bloc_value3<2, 4>(ii, 0);
+            if (end - ii == 1) gemm_bloc_value3<1, 4>(ii, 0);
