              "role": "assistant",
              "content": "```js\nexport function mergeIntervalInterval(intervals) {\n  if (!Array.isArray(intervals)) {\n    throw new Error(\"Input must be an array.\");\n  }\n\n  const processedInterval = (interval) => {\n    if (!Array.isArray(interval) || interval.length !== 2 ||\n        !Number.isFinite(interval[0]) || !Number.isFinite(interval[1])) {\n      throw new Error(\"Interval must be an array of two finite numbers.\");\n    }\n    const [start, end] = [...interval];\n    return start > end ? [end, start] : [start, end];\n  };\n\n  const validatedAndProcessed = intervals.map(processedInterval);\n\n  if (validatedAndProcessed.length === 0) {\n    return [];\n  }\n\n  // Sort by start time\n  const sortedInterval = [...validatedAndProcessed].sort((a, b) => a[0] - b[0]);\n\n  const merged = [];\n  let currentInterval = [...sortedInterval[0]];\n\n  for (let i = 1; i < sortedInterval.length; i++) {\n    const nextInterval = sortedInterval[i];\n    const [currentStart, currentEnd] = currentInterval;\n    const [nextStart, nextEnd] = nextInterval;\n\n    // Check for overlap or touching: nextStart <= currentEnd\n    if (nextStart <= currentEnd) {\n      // Merge: extend the end of the current interval\n      currentInterval = [currentStart, Math.max(currentEnd, nextEnd)];\n    } else {\n      // No overlap, push current and start a new one\n      merged.push([...currentInterval]);\n      currentInterval = [...nextInterval];\n    }\n  }\n\n  // Push the last processed interval\n  merged.push([...currentInterval]);\n\n  return merged;\n}\n```"
