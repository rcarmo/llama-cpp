+    NOINLINE void gemm_score3(int64_t m) {
+        const int64_t nb_job = (m + 47) / 48;
+        if (params->ith == 0) ggml_threadpool_chunk_set(params->threadpool, params->nth);
+        ggml_barrier(params->threadpool);
+        int64_t job = params->ith;
+        while (job < nb_job) {
+            const int64_t begin = job * 48;
+            const int64_t end = begin + 48 < m ? begin + 48 : m;
+            int64_t ii = begin;
+            for (; ii + 3 <= end; ii += 3) gemm_bloc<3, 4>(ii, 0);
+            if (end - ii == 2) gemm_bloc<2, 4>(ii, 0);
+            if (end - ii == 1) gemm_bloc<1, 4>(ii, 0);
+            job = ggml_threadpool_chunk_add(params->threadpool, 1);
+        }
+        ggml_barrier(params->threadpool);
+    }
