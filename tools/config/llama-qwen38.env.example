# Qwen 3.8 27B local provider for the Intel i5-1340P / 32 GiB Sigma.
# Stop the Gemma, Maple, and Qwen 3.6 services before starting this provider.
LLAMA_ROOT=/var/home/agent/workspace/projects/llama-cpp
LLAMA_BUILD=/var/home/agent/workspace/projects/llama-cpp/build-intel-clang
LLAMA_MODEL_DIR=/var/home/agent/workspace/projects/models/qwen3.8-27b
LLAMA_MODEL=/var/home/agent/workspace/projects/models/qwen3.8-27b/Qwen3.8-27B-Q4_K_M.gguf
LLAMA_MTP_MODEL=/var/home/agent/workspace/projects/models/qwen3.8-27b/mtp-Qwen3.8-27B-Q4_0.gguf
# Set to 0 for the slower target-only profile with lower swap risk.
LLAMA_USE_MTP=1
# Set this only when vision input is required; it adds memory pressure.
# LLAMA_MM_PROJ=/var/home/agent/workspace/projects/models/qwen3.8-27b/mmproj-Qwen3.8-27B-Q8_0.gguf
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8094
LLAMA_CTX=8192
LLAMA_CPUS=0-7
LLAMA_PROCESS_CPUS=0-15
LLAMA_THREADS=8
LLAMA_BATCH=1024
LLAMA_UBATCH=256
LLAMA_KV=q4_0
LLAMA_MTP_DEPTH=3
LLAMA_CACHE_RAM_MIB=0
LLAMA_HTTP_TIMEOUT=28800
LLAMA_SLOT_DIR=/var/home/agent/.cache/llama-qwen38/slots/
