# Intel Core i5-1340P Gemma 4 E4B local-provider profile
# Install as ~/.config/llama-gemma-local-provider/service.env.

LLAMA_ROOT=/var/home/agent/workspace/projects/llama-cpp
LLAMA_BUILD=/var/home/agent/workspace/projects/llama-cpp/build-intel-clang
LLAMA_MODEL=/var/home/agent/workspace/projects/models/gemma-4-e4b-qat-mtp/gemma-4-E4B_q4_0-it.gguf
LLAMA_DRAFT_MODEL=/var/home/agent/workspace/projects/models/gemma-4-e4b-qat-mtp/gemma-4-E4B-it-qat-assistant-MTP-Q8_0.gguf
LLAMA_ALIAS=gemma-4-e4b-qat-mtp

LLAMA_HOST=127.0.0.1
LLAMA_PORT=8091
# Two independent 128K slots require a 256K aggregate server context. Pi still
# advertises 128K because each request is limited by its slot, not this total.
LLAMA_CTX=262144
LLAMA_MTP_DEPTH=3

# Two isolated KV streams outperformed both queued single-slot serving and
# 2/4-slot unified KV on the i5-1340P. Four callers run in two concurrent waves.
LLAMA_PARALLEL=2
LLAMA_KV_UNIFIED=off
LLAMA_CONT_BATCHING=on

# Repeated 3K gate: +7.24% generation, +13.16% prompt and +12.97% wall speed
# against Q8_0 KV with Flash Attention enabled.
LLAMA_KV=f16
LLAMA_FLASH_ATTN=off
LLAMA_LOAD_MODE=mmap
LLAMA_BATCH=1024
LLAMA_UBATCH=256

LLAMA_THREADS=8
LLAMA_CPUS=0-7
LLAMA_PROCESS_CPUS=0-15
# Target/assistant: 16 prefill threads, 8 decode threads. CPU masks request
# placement; this server's OpenMP path does not enforce worker pinning.
LLAMA_THREADS_BATCH=16
LLAMA_CPUS_BATCH=0-15

# On-demand limit for serialized prompt states, with idle-slot admission.
# Prefix reuse and checkpoints are supported. The 256-token chunk-shift hint
# is ignored by contexts that cannot shift; it is not a cache-hit guarantee.
LLAMA_CACHE_RAM_MIB=12288
LLAMA_CACHE_IDLE_SLOTS=on
LLAMA_CACHE_REUSE=256
LLAMA_CTX_CHECKPOINTS=32
LLAMA_CHECKPOINT_MIN_STEP=8192
LLAMA_HTTP_TIMEOUT=10800
LLAMA_SLOT_DIR=/var/home/agent/.cache/llama-candidates/gemma4/slots/

GGML_CPU_EXPERT_IO_PROFILE=1
GGML_CPU_EXPERT_IO_ADVISE_MODE=off
