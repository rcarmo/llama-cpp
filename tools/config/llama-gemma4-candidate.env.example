# Intel Core i5-1340P Gemma 4 E4B candidate
# Copy to ~/.config/llama-candidate/service.env only for an explicit trial.

LLAMA_ROOT=/var/home/agent/workspace/projects/llama-cpp
LLAMA_BUILD=/var/home/agent/workspace/projects/llama-cpp/build-intel-clang
LLAMA_MODEL=/var/home/agent/workspace/projects/models/gemma-4-e4b-qat-mtp/gemma-4-E4B_q4_0-it.gguf
LLAMA_DRAFT_MODEL=/var/home/agent/workspace/projects/models/gemma-4-e4b-qat-mtp/gemma-4-E4B-it-qat-assistant-MTP-Q8_0.gguf
LLAMA_ALIAS=gemma-4-e4b-qat-mtp

LLAMA_HOST=127.0.0.1
LLAMA_PORT=8091
LLAMA_CTX=32768
LLAMA_MTP_DEPTH=3

# Repeated 3K gate: +7.24% generation, +13.16% prompt and +12.97% wall speed
# against Q8_0 KV with Flash Attention enabled.
LLAMA_KV=f16
LLAMA_FLASH_ATTN=off
LLAMA_LOAD_MODE=mmap
LLAMA_BATCH=512
LLAMA_UBATCH=128

LLAMA_THREADS=8
LLAMA_CPUS=0-7
LLAMA_PROCESS_CPUS=0-15
LLAMA_CACHE_RAM_MIB=0
LLAMA_HTTP_TIMEOUT=3600
LLAMA_SLOT_DIR=/var/home/agent/.cache/llama-candidates/gemma4/slots/

GGML_CPU_EXPERT_IO_PROFILE=1
GGML_CPU_EXPERT_IO_ADVISE_MODE=off
