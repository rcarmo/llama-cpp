# sigma / Intel Core i5-1340P Qwen3.6 long-context service
# Install as: ~/.config/llama-qwen-longctx/service.env

LLAMA_ROOT=/var/home/agent/workspace/projects/llama-cpp
LLAMA_BUILD=/var/home/agent/workspace/projects/llama-cpp/build-intel-clang
LLAMA_MODEL=/var/home/agent/workspace/projects/models/qwen3.6/Qwen3.6-35B-A3B-UD-Q2_K_XL.gguf

# LAN endpoint. No API key is configured by this profile.
LLAMA_HOST=0.0.0.0
LLAMA_PORT=8090

# One 128K slot. Native MTP does not support parallel slots in this profile.
LLAMA_CTX=131072
LLAMA_MTP_DEPTH=3

# Selected by the agentic parameter sweep.
LLAMA_KV=q4_0
LLAMA_BATCH=1024
LLAMA_UBATCH=256

# Four P-core SMT pairs are logical CPUs 0-7. The process may use all CPUs for
# bounded server/helper work; model workers remain on 0-7.
LLAMA_THREADS=8
LLAMA_CPUS=0-7
LLAMA_PROCESS_CPUS=0-15

# Disable the separate RAM prompt-state cache. Same-slot common-prefix reuse
# remains enabled by --cache-prompt in the launcher.
LLAMA_CACHE_RAM_MIB=0
LLAMA_SLOT_DIR=/var/home/agent/.cache/llama-qwen-longctx/slots/

# Long requests can take several hours near 96K tokens on this CPU.
LLAMA_HTTP_TIMEOUT=28800

# Router-aware Qwen expert metrics and miss-only asynchronous page advice.
GGML_CPU_EXPERT_IO_PROFILE=1
GGML_CPU_EXPERT_IO_ADVISE_MODE=bounded
