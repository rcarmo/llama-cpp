[Unit]
Description=Gemma 4 E4B dual-slot 128K MTP llama.cpp local provider
Documentation=file:///var/home/agent/workspace/projects/llama-cpp/docs/gemma-local-provider-runbook.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/bash /var/home/agent/workspace/projects/llama-cpp/tools/run-intel-candidate.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
KillSignal=SIGTERM
EnvironmentFile=%h/.config/llama-gemma-local-provider/service.env

[Install]
WantedBy=default.target
