[Unit]
Description=Maple Preview dual-slot 128K llama.cpp local provider
Documentation=file:///var/home/agent/workspace/projects/llama-cpp/docs/maple-local-provider-runbook.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/bash /var/home/agent/workspace/projects/llama-cpp/tools/run-intel-maple-provider.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
KillSignal=SIGTERM
EnvironmentFile=-%h/.config/llama-maple-local-provider/service.env

[Install]
WantedBy=default.target
