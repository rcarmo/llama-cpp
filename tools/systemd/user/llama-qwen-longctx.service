[Unit]
Description=Qwen3.6 35B-A3B 128K MTP llama.cpp server
Documentation=file:///var/home/agent/workspace/projects/llama-cpp/docs/intel-1340p-qwen-longctx-runbook.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/bash /var/home/agent/workspace/projects/llama-cpp/tools/run-intel-qwen-longctx.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
KillSignal=SIGTERM
EnvironmentFile=-%h/.config/llama-qwen-longctx/service.env

[Install]
WantedBy=default.target
